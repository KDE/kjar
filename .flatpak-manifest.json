{
  "id": "org.kde.kjar",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "kjarapp",

  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.openjdk25"
  ],

  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=x11",
    "--device=dri",
    "--filesystem=home",
    "--env=JAVA_HOME=/app/jdk",
    "--env=PATH=/app/bin:/app/jdk/bin:/usr/bin"
  ],

  "modules": [
    {
      "name": "openjdk",
      "buildsystem": "simple",
      "build-commands": [
        "/usr/lib/sdk/openjdk25/installjdk.sh",
        "rm -f /app/jdk/lib/src.zip",
        "sh strip-jmods.sh"
      ],
      "sources": [
        {
          "type": "file",
          "path": "strip-jmods.sh"
        }
      ]
    },
    {
      "name": "openjfx",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/share/javafx",
        "install -m644 lib/*.jar /app/share/javafx/",
        "install -m644 lib/*.so  /app/share/javafx/",
        "cp -r legal /app/share/javafx/legal"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download2.gluonhq.com/openjfx/25/openjfx-25_linux-x64_bin-sdk.zip",
          "sha256": "a72157506746f03de493171313ec93425f1ec1b5cb4b446eee9a568ff484af4e",
          "dest": ".",
          "x-checker-data": {
            "type": "html",
            "url": "https://gluonhq.com/products/javafx/",
            "version-pattern": "openjfx-(\\d[\\d.]*)_linux-x64_bin-sdk\\.zip",
            "url-template": "https://download2.gluonhq.com/openjfx/${version}/openjfx-${version}_linux-x64_bin-sdk.zip"
          }
        }
      ]
    },
    {
      "name": "kjar",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
